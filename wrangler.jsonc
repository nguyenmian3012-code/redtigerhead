{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redtigerhead",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "redtigerhead",
      "workers_dev": true,
      "preview_urls": false
    }
  }
}
