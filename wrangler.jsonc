{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redtigerhead",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "redtigerhead.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "redtigerhead-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "preview.redtigerhead.com",
          "custom_domain": true
        }
      ]
    }
  }
}
