---
interface Props {
  name: "factory" | "shield" | "truck" | "leaf" | "raw" | "processing" | "refining" | "drying" | "clipboard" | "bag" | "pin" | "phone" | "mail" | "globe" | "clock" | "arrow" | "star" | "info";
  size?: number;
  label?: string;
}

const { name, size = 24, label } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role={label ? "img" : undefined} aria-hidden={label ? undefined : "true"} aria-label={label}>
  {name === "factory" && <><path d="M3 21V9l6 3V8l6 4V5h3v16"/><path d="M2 21h20M7 17h1m4 0h1m4 0h1"/></>}
  {name === "shield" && <><path d="M12 3 20 6v6c0 4.7-3.1 7.5-8 9-4.9-1.5-8-4.3-8-9V6z"/><path d="m8.5 12 2.2 2.2 4.9-5"/></>}
  {name === "truck" && <><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></>}
  {name === "leaf" && <><path d="M20 4C11 4 5 8 5 15c0 3 2 5 5 5 7 0 10-8 10-16Z"/><path d="M4 21c2-6 6-10 12-13"/></>}
  {name === "raw" && <><path d="M12 20V8M12 13c-4 0-6-2-6-6 4 0 6 2 6 6Zm0 3c4 0 6-2 6-6-4 0-6 2-6 6Z"/><path d="M8 21h8"/></>}
  {name === "processing" && <><path d="M3 21V11l5 3v-3l5 3V8l4 2v11"/><path d="M2 21h20M17 8V4h3v17"/></>}
  {name === "refining" && <><path d="M9 3h6M10 3v5l-5 9a3 3 0 0 0 3 4h8a3 3 0 0 0 3-4l-5-9V3"/><path d="M8 16h8"/></>}
  {name === "drying" && <><path d="M5 20h14M7 16c-2-2 2-3 0-6m5 6c-2-2 2-3 0-6m5 6c-2-2 2-3 0-6"/></>}
  {name === "clipboard" && <><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4a3 3 0 0 1 6 0v2H9zM9 13l2 2 4-5"/></>}
  {name === "bag" && <><path d="M8 4h8l-1 4c3 3 4 7 3 12H6c-1-5 0-9 3-12z"/><path d="M9 8h6M9 15h6"/></>}
  {name === "pin" && <><path d="M12 21s7-6 7-12A7 7 0 1 0 5 9c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2"/></>}
  {name === "phone" && <path d="M7 3 4 5c0 8 7 15 15 15l2-3-5-3-2 2c-3-1-5-3-6-6l2-2z"/>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
  {name === "globe" && <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></>}
  {name === "clock" && <><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></>}
  {name === "arrow" && <><path d="M5 12h13M14 7l5 5-5 5"/></>}
  {name === "star" && <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/>}
  {name === "info" && <><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7h.01"/></>}
</svg>
