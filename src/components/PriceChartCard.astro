---
interface PricePoint {
  date: string;
  value: number;
  unit: string;
}

interface Props {
  title: string;
  titleEn: string;
  titleZh: string;
  series: PricePoint[];
  tone: "red" | "gold" | "coral";
  exchangeRates: {
    usd_vnd: number;
    cny_vnd: number;
  };
}

const { title, titleEn, titleZh, series, tone, exchangeRates } = Astro.props;
const width = 560;
const height = 168;
const left = 52;
const right = 548;
const top = 12;
const bottom = 132;
const values = series.map((point) => Number(point.value));
const rawMin = Math.min(...values);
const rawMax = Math.max(...values);
const step = rawMax > 6000 ? 1000 : rawMax > 3000 ? 500 : 250;
const yMin = Math.floor((rawMin - step * 0.3) / step) * step;
const yMax = Math.ceil((rawMax + step * 0.3) / step) * step;
const range = Math.max(1, yMax - yMin);
const points = series.map((point, index) => ({
  x: left + (index * (right - left)) / Math.max(1, series.length - 1),
  y: bottom - ((Number(point.value) - yMin) / range) * (bottom - top),
  point
}));
const pathD = points.map((point, index) => (index === 0 ? "M" : "L") + point.x.toFixed(2) + " " + point.y.toFixed(2)).join(" ");
const tickCount = Math.round(range / step) + 1;
const ticks = Array.from({ length: tickCount }, (_, index) => {
  const ratio = index / Math.max(1, tickCount - 1);
  return {
    y: top + ratio * (bottom - top),
    value: Math.round(yMax - ratio * range)
  };
});
const lastIndex = series.length - 1;
const labelStride = series.length > 14 ? 2 : 1;
const dateIndexes = series
  .map((_, index) => index)
  .filter((index) => index === 0 || index === lastIndex || index % labelStride === 0);
const formatDate = (date: string) => {
  const parts = date.split("-");
  return parts[2] + "/" + parts[1];
};
const latest = series[series.length - 1];
const latestUsd = Number(latest.value) / exchangeRates.usd_vnd;
const latestRmb = Number(latest.value) / exchangeRates.cny_vnd;
---
<section class:list={["price-card", "tone-" + tone]} aria-label={title}>
  <div class="price-name">
    <b data-i18n data-vi={title} data-en={titleEn} data-zh={titleZh}>{title}</b>
    <small>(VND/kg)</small>
  </div>
  <div class="chart-body">
    <svg class="price-chart" viewBox={"0 0 " + width + " " + height} role="img" aria-label={title + " — dữ liệu tham khảo"}>
      {ticks.map((tick) => (
        <>
          <line class="grid-line" x1={left} x2={right} y1={tick.y} y2={tick.y} />
          <text class="axis-label" x="1" y={tick.y + 4}>{tick.value.toLocaleString("en-US")}</text>
        </>
      ))}
      <path class="series-line" d={pathD} />
      {points.map((point) => (
        <circle class="series-point" cx={point.x} cy={point.y} r="3">
          <title>{point.point.date + ": " + Number(point.point.value).toLocaleString("en-US") + " " + point.point.unit}</title>
        </circle>
      ))}
      {dateIndexes.map((index) => (
        <text class="date-label" x={points[index].x} y="160" text-anchor={index === 0 ? "start" : index === series.length - 1 ? "end" : "middle"}>
          {formatDate(series[index].date)}
        </text>
      ))}
    </svg>
    <div class="latest-box">
      <strong>{Number(latest.value).toLocaleString("en-US")}</strong>
      <small>{latest.unit}</small>
      <small class="latest-converted" data-i18n data-vi={`≈ ${latestUsd.toFixed(2)} USD/kg`} data-en={`≈ ${latestUsd.toFixed(2)} USD/kg`} data-zh={`≈ ¥${latestRmb.toFixed(2)} RMB/kg`}>≈ ${latestUsd.toFixed(2)} USD/kg</small>
      <em>{formatDate(latest.date)}</em>
    </div>
  </div>
</section>
