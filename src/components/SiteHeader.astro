---
interface Props {
  active: "home" | "about" | "price" | "careers" | "contact";
}

const { active } = Astro.props;
const activeHref = {
  home: "/",
  about: "/",
  price: "/",
  careers: "/tuyen-dung/",
  contact: "/lien-he/"
}[active];
const nav = [
  { href: "/", vi: "Trang chủ", en: "Home", zh: "首页" },
  { href: "/#thong-so", vi: "Thông số sản phẩm", en: "Product Specs", zh: "产品参数" },
  { href: "/tuyen-dung/", vi: "Tuyển dụng", en: "Careers", zh: "招聘" },
  { href: "/lien-he/", vi: "Liên hệ", en: "Contact", zh: "联系" }
];
const languages = active === "careers"
  ? [{ code: "vi", label: "VN" }, { code: "en", label: "EN" }]
  : [{ code: "vi", label: "VN" }, { code: "en", label: "EN" }, { code: "zh", label: "CN" }];
---
<header class="site-header">
  <div class="shell nav-row">
    <a class="brand" href="/" aria-label="Bình Minh — Trang chủ">
      <span class="brand-logo-frame" aria-hidden="true">
        <img class="brand-logo" src="/assets/binh-minh-logo-v2.png" alt="" width="46" height="49" />
      </span>
      <span class="brand-word">BINH MINH</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Mở menu">
      <span></span><span></span><span></span>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Điều hướng chính">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: item.href === activeHref }} aria-current={item.href === activeHref ? "page" : undefined} data-i18n data-vi={item.vi} data-en={item.en} data-zh={item.zh}>
          {item.vi}
        </a>
      ))}
    </nav>
    <div class="nav-tools">
      <div class="lang-switch" role="group" aria-label="Chọn ngôn ngữ">
        {languages.map((language) => (
          <button type="button" data-lang={language.code} class:list={{ active: language.code === "vi" }} aria-pressed={language.code === "vi" ? "true" : "false"}>{language.label}</button>
        ))}
      </div>
      <span class="tool-divider" aria-hidden="true"></span>
      <button class="theme-toggle" type="button" aria-label="Đổi giao diện sáng tối">
        <span class="sun">☼</span><span class="moon">◔</span>
      </button>
    </div>
  </div>
</header>
