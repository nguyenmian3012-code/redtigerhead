---
import Icon from "./Icon.astro";
import { copy, i18n, site } from "../data/site";
---
<footer class="site-footer" id="contact">
  <div class="footer-watermark" aria-hidden="true">虎</div>
  <div class="shell footer-grid">
    <div class="footer-brand">
      <div class="brand footer-logo-wrap">
        <img class="brand-logo footer-logo" data-logo alt="" width="58" height="58" />
        <span class="brand-word">{site.wordmark}</span>
      </div>
      <p {...i18n("footer.tagline")}>{copy.vi["footer.tagline"]}</p>
      <div class="social-row" aria-label="Mạng xã hội">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="YouTube">▶</a>
        <a href="#" aria-label="LinkedIn">in</a>
      </div>
    </div>
    <div class="footer-contact">
      <h2 {...i18n("footer.contact")}>{copy.vi["footer.contact"]}</h2>
      <p><Icon name="pin" size={17} /><span>{site.address}</span></p>
      <p><Icon name="phone" size={17} /><a href={"tel:" + site.phone.replaceAll(" ", "")}>{site.phone}</a></p>
      <p><Icon name="mail" size={17} /><a href={"mailto:" + site.email}>{site.email}</a></p>
      <p><Icon name="globe" size={17} /><a href={"https://" + site.domain}>www.{site.domain}</a></p>
    </div>
    <div class="footer-hours">
      <h2 {...i18n("footer.hours")}>{copy.vi["footer.hours"]}</h2>
      <p><Icon name="clock" size={17} /><span>{site.hours.weekdays}<br />{site.hours.sunday}</span></p>
      <div class="footer-rule"></div>
      <p class="copyright">© 2026 Bình Minh.<br />All rights reserved.</p>
    </div>
  </div>
</footer>
