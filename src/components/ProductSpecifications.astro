---
import Icon from "./Icon.astro";

const rows = [
  { vi: "Độ ẩm", en: "Moisture Content", zh: "水分", unit: "%", limit: "≤ 13" },
  { vi: "pH", en: "pH", zh: "pH", unit: "—", limit: "6.4 – 7.0" },
  { vi: "Độ trắng", en: "Whiteness", zh: "白度", unit: "%", limit: "> 90" }
];

const characteristics = [
  { icon: "star", vi: "Ngoại quan", en: "Appearance", zh: "外观", viText: "Bột mịn, tơi, màu trắng đến trắng kem nhạt.", enText: "Fine, free-flowing powder, white to light-cream.", zhText: "粉末细腻、流动性好，颜色白至浅奶油色。" },
  { icon: "shield", vi: "Mùi & vị", en: "Taste & odor", zh: "气味与口感", viText: "Vị trung tính, không có mùi lạ hay tạp mùi bất thường.", enText: "Neutral taste with no foreign or abnormal odor.", zhText: "味道中性，无异味或异常气味。" },
  { icon: "bag", vi: "Đóng gói", en: "Packaging", zh: "包装", viText: "Bao 10 kg, 25 kg và 50 kg; quy cách theo đơn hàng.", enText: "10 kg, 25 kg and 50 kg bags; configuration per order.", zhText: "10 公斤、25 公斤和 50 公斤包装；具体规格按订单约定。" },
  { icon: "factory", vi: "Ứng dụng", en: "Applications", zh: "应用", viText: "Phù hợp nhiều ứng dụng công nghiệp và thực phẩm tùy theo cấp chất lượng và COA.", enText: "Suitable for multiple industrial and food applications depending on grade and COA.", zhText: "可根据等级与 COA 用于多种工业及食品用途。" }
] as const;
---
<section class="product-spec-section porcelain-zone" id="thong-so" aria-labelledby="spec-title">
  <div class="shell">
    <article class="panel product-spec-panel">
      <div class="product-spec-head">
        <div>
          <p class="section-kicker" data-i18n data-vi="THÔNG SỐ SẢN PHẨM" data-en="PRODUCT SPECIFICATIONS" data-zh="产品参数">THÔNG SỐ SẢN PHẨM</p>
          <h2 id="spec-title" data-i18n data-vi="Native Tapioca Starch — Thông số tham khảo Bình Minh" data-en="Native Tapioca Starch — Binh Minh reference specifications" data-zh="Native Tapioca Starch — Binh Minh 参考参数">Native Tapioca Starch — Thông số tham khảo Bình Minh</h2>
          <p data-i18n data-vi="Bảng thông tin kỹ thuật được trình bày ngắn gọn để khách hàng và đối tác dễ đối chiếu. Thông số thương mại cuối cùng được xác nhận theo COA, lô hàng và mục đích sử dụng." data-en="A concise technical reference for customers and partners. Final commercial specifications are confirmed by COA, production lot and end-use requirements." data-zh="为客户与合作伙伴提供简洁的技术参考。最终商业参数以 COA、生产批次及具体用途要求为准。">Bảng thông tin kỹ thuật được trình bày ngắn gọn để khách hàng và đối tác dễ đối chiếu. Thông số thương mại cuối cùng được xác nhận theo COA, lô hàng và mục đích sử dụng.</p>
        </div>
        <span class="spec-badge">BINH MINH · NATIVE STARCH</span>
      </div>

      <div class="spec-table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th data-i18n data-vi="Thông số" data-en="Parameter" data-zh="参数">Thông số</th>
              <th data-i18n data-vi="Đơn vị" data-en="Unit" data-zh="单位">Đơn vị</th>
              <th data-i18n data-vi="Tiêu chuẩn / giới hạn tham khảo" data-en="Reference standard / limit" data-zh="参考标准 / 限值">Tiêu chuẩn / giới hạn tham khảo</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td data-i18n data-vi={row.vi} data-en={row.en} data-zh={row.zh}>{row.vi}</td>
                <td>{row.unit}</td>
                <td>{row.limit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <section class="spec-characteristics" aria-labelledby="characteristics-title">
        <h3 id="characteristics-title" data-i18n data-vi="TÍNH CHẤT SẢN PHẨM" data-en="PRODUCT CHARACTERISTICS" data-zh="产品特性">TÍNH CHẤT SẢN PHẨM</h3>
        <ul class="spec-characteristic-list">
          {characteristics.map((item) => (
            <li>
              <span class="spec-characteristic-icon"><Icon name={item.icon} size={19} /></span>
              <div>
                <b data-i18n data-vi={item.vi} data-en={item.en} data-zh={item.zh}>{item.vi}</b>
                <p data-i18n data-vi={item.viText} data-en={item.enText} data-zh={item.zhText}>{item.viText}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <p class="spec-footnote" data-i18n data-vi="Lưu ý: yêu cầu cụ thể thay đổi theo ứng dụng công nghiệp, thực phẩm hoặc các cấp chất lượng nghiêm ngặt hơn; các yêu cầu về kim loại nặng và vi sinh cần được xác nhận riêng khi áp dụng." data-en="Note: requirements vary by industrial, food or stricter grades; heavy-metal and microbiological requirements should be confirmed separately when applicable." data-zh="注：不同工业、食品或更严格等级的要求会有所不同；如适用，重金属与微生物指标应另行确认。">Lưu ý: yêu cầu cụ thể thay đổi theo ứng dụng công nghiệp, thực phẩm hoặc các cấp chất lượng nghiêm ngặt hơn; các yêu cầu về kim loại nặng và vi sinh cần được xác nhận riêng khi áp dụng.</p>
    </article>
  </div>
</section>
