---
import Icon from "./Icon.astro";
import { productSpecifications } from "../data/products";

type LocalizedText = { readonly vi: string; readonly en: string; readonly zh: string };
const localized = (value: string | LocalizedText): LocalizedText =>
  typeof value === "string" ? { vi: value, en: value, zh: value } : value;
---
<section class="product-spec-section porcelain-zone" id="thong-so" aria-labelledby="spec-section-title">
  <div class="shell">
    <article class="panel product-spec-panel" data-product-slider>
      <div class="product-spec-title-row">
        <p id="spec-section-title" class="section-kicker" data-i18n data-vi="THÔNG SỐ SẢN PHẨM" data-en="PRODUCT SPECIFICATIONS" data-zh="产品参数">THÔNG SỐ SẢN PHẨM</p>
        <span class="spec-draft" data-i18n data-vi="DỮ LIỆU THAM KHẢO" data-en="REFERENCE DATA" data-zh="参考数据">DỮ LIỆU THAM KHẢO</span>
      </div>

      <div class="product-tabs" role="tablist" aria-label="Product specifications">
        {productSpecifications.map((product, index) => (
          <button
            class="product-tab"
            type="button"
            role="tab"
            id={`product-tab-${product.id}`}
            aria-controls={`product-panel-${product.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-product-tab
            data-i18n
            data-vi={product.tab.vi}
            data-en={product.tab.en}
            data-zh={product.tab.zh}
          >{product.tab.vi}</button>
        ))}
      </div>

      {productSpecifications.map((product, productIndex) => {
        const rows = product.specs.slice(0, 3).map((left, index) => ({ left, right: product.specs[index + 3] }));
        return (
          <section
            class="product-tab-panel"
            role="tabpanel"
            id={`product-panel-${product.id}`}
            aria-labelledby={`product-tab-${product.id}`}
            hidden={productIndex !== 0}
            data-product-panel
          >
            <div class="product-spec-head">
              <div>
                <h2 data-i18n data-vi={product.title.vi} data-en={product.title.en} data-zh={product.title.zh}>{product.title.vi}</h2>
                <p data-i18n data-vi={product.description.vi} data-en={product.description.en} data-zh={product.description.zh}>{product.description.vi}</p>
              </div>
              <span class="spec-badge">{product.badge}</span>
            </div>

            <div class="spec-table-wrap">
              <table class="spec-table spec-table-paired">
                <thead>
                  <tr>
                    <th data-i18n data-vi="Thông số" data-en="Parameter" data-zh="参数">Thông số</th>
                    <th data-i18n data-vi="Đơn vị" data-en="Unit" data-zh="单位">Đơn vị</th>
                    <th data-i18n data-vi="Mức tham khảo" data-en="Reference" data-zh="参考值">Mức tham khảo</th>
                    <th class="spec-pair-start" data-i18n data-vi="Thông số" data-en="Parameter" data-zh="参数">Thông số</th>
                    <th data-i18n data-vi="Đơn vị" data-en="Unit" data-zh="单位">Đơn vị</th>
                    <th data-i18n data-vi="Mức tham khảo" data-en="Reference" data-zh="参考值">Mức tham khảo</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(({ left, right }) => {
                    const leftValue = localized(left.value);
                    const rightValue = localized(right.value);
                    return (
                      <tr>
                        <td data-i18n data-vi={left.label.vi} data-en={left.label.en} data-zh={left.label.zh}>{left.label.vi}</td>
                        <td>{left.unit}</td>
                        <td data-i18n data-vi={leftValue.vi} data-en={leftValue.en} data-zh={leftValue.zh}>{leftValue.vi}</td>
                        <td class="spec-pair-start" data-i18n data-vi={right.label.vi} data-en={right.label.en} data-zh={right.label.zh}>{right.label.vi}</td>
                        <td>{right.unit}</td>
                        <td data-i18n data-vi={rightValue.vi} data-en={rightValue.en} data-zh={rightValue.zh}>{rightValue.vi}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            <section class="spec-characteristics" aria-labelledby={`characteristics-${product.id}`}>
              <h3 id={`characteristics-${product.id}`} data-i18n data-vi="TÍNH CHẤT & ỨNG DỤNG" data-en="CHARACTERISTICS & APPLICATIONS" data-zh="特性与应用">TÍNH CHẤT & ỨNG DỤNG</h3>
              <ul class="spec-characteristic-list">
                {product.characteristics.map((item) => (
                  <li>
                    <span class="spec-characteristic-icon"><Icon name={item.icon} size={19} /></span>
                    <div>
                      <b data-i18n data-vi={item.title.vi} data-en={item.title.en} data-zh={item.title.zh}>{item.title.vi}</b>
                      <p data-i18n data-vi={item.text.vi} data-en={item.text.en} data-zh={item.text.zh}>{item.text.vi}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </section>

            <p class="spec-footnote" data-i18n data-vi={product.footnote.vi} data-en={product.footnote.en} data-zh={product.footnote.zh}>{product.footnote.vi}</p>
          </section>
        );
      })}
    </article>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-slider]").forEach((slider) => {
    const tabs = [...slider.querySelectorAll<HTMLButtonElement>("[data-product-tab]")];
    const panels = [...slider.querySelectorAll<HTMLElement>("[data-product-panel]")];
    let active = 0;
    let timer: number | undefined;

    const show = (index: number, focus = false) => {
      active = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, itemIndex) => {
        const selected = itemIndex === active;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[itemIndex].hidden = !selected;
      });
      if (focus) tabs[active].focus();
    };

    const pause = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        pause();
        show(index);
      });
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        pause();
        show(index + (event.key === "ArrowRight" ? 1 : -1), true);
      });
    });

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      timer = window.setInterval(() => show(active + 1), 5000);
    }
  });
</script>
