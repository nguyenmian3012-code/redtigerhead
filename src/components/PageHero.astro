---
import { copy, i18n, type CopyKey } from "../data/site";

interface Props {
  kicker: CopyKey;
  title: CopyKey;
  lead: CopyKey;
  image?: boolean;
  className?: string;
}

const { kicker, title, lead, image = false, className } = Astro.props;
---
<section class:list={["page-hero", "wine-zone", className]}>
  <div class:list={["shell", "page-hero-grid", { "with-image": image }]}>
    <div>
      <p class="eyebrow gold" {...i18n(kicker)}>{copy.vi[kicker]}</p>
      <h1 {...i18n(title)}>{copy.vi[title]}</h1>
      <p {...i18n(lead)}>{copy.vi[lead]}</p>
    </div>
    {image && <div class="about-photo" data-hero role="img" aria-label="Khu vực nhà máy Bình Minh"></div>}
  </div>
</section>
