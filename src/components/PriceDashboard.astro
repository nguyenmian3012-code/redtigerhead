---
import Icon from "./Icon.astro";
import PriceChartCard from "./PriceChartCard.astro";
import priceData from "../data/prices.json";
import { copy, i18n } from "../data/site";
---
<aside class="panel market-card" id="market">
  <div class="market-header">
    <h2 class="section-kicker" {...i18n("market.title")}>{copy.vi["market.title"]}</h2>
    <p class="market-note" title="Giá bột thành phẩm được đồng bộ từ nguồn nội bộ tối đa hai lần mỗi ngày; giao dịch thực tế có thể thay đổi theo điều kiện đơn hàng.">
      <Icon name="info" size={18} />
      <span data-i18n data-vi="Giá bột: dữ liệu nội bộ, đồng bộ 2 lần/ngày. Giá giao dịch thực tế có thể thay đổi theo đơn hàng." data-en="Starch price: internal source, synchronized twice daily. Actual transaction prices may vary by order." data-zh="淀粉价格：来自内部数据，每日同步两次；实际成交价可能因订单条件而变化。">Giá bột: dữ liệu nội bộ, đồng bộ 2 lần/ngày. Giá giao dịch thực tế có thể thay đổi theo đơn hàng.</span>
    </p>
  </div>
  <PriceChartCard title={copy.vi["market.starch"]} titleEn={copy.en["market.starch"]} titleZh={copy.zh["market.starch"]} series={priceData.starch} tone="red" />
  <PriceChartCard title={copy.vi["market.root"]} titleEn={copy.en["market.root"]} titleZh={copy.zh["market.root"]} series={priceData.root} tone="gold" />
  <PriceChartCard title={copy.vi["market.residue"]} titleEn={copy.en["market.residue"]} titleZh={copy.zh["market.residue"]} series={priceData.residue} tone="coral" />
</aside>
