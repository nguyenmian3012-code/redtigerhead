---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
---
<BaseLayout title="Liên hệ | Bình Minh" description="Thông tin liên hệ công khai của Bình Minh.">
  <SiteHeader active="contact" />
  <main id="main">
    <PageHero kicker="contact.kicker" title="contact.title" lead="contact.lead" />
    <section class="content-section porcelain-zone">
      <div class="shell contact-grid">
        <article class="panel contact-card">
          <Icon name="pin" size={28} />
          <h2>Địa chỉ</h2>
          <p>{site.address}</p>
        </article>
        <article class="panel contact-card">
          <Icon name="phone" size={28} />
          <h2>Điện thoại</h2>
          <p><a href={"tel:" + site.phone.replaceAll(" ", "")}>{site.phone}</a></p>
        </article>
        <article class="panel contact-card">
          <Icon name="mail" size={28} />
          <h2>Email</h2>
          <p><a href={"mailto:" + site.email}>{site.email}</a></p>
        </article>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
