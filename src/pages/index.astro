---
import BaseLayout from '../layouts/baselayout.astro';
import SectionHeading from '../components/sectionheading.astro';

const principles = [
  ['Chính trực', 'Minh bạch'],
  ['Tôn trọng', 'Hợp tác'],
  ['Trách nhiệm', 'Kỷ luật'],
  ['Đổi mới', 'Hiệu quả'],
  ['An toàn', 'Bền vững'],
];
---

<BaseLayout
  title="Bình Minh | Sản xuất tinh bột sắn từ năm 1984"
  description="Binh Minh Tapioca Starch Production Limited — doanh nghiệp sản xuất tinh bột sắn với công suất trung bình khoảng 200 tấn mỗi ngày."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Năng lực sản xuất · Tinh bột sắn</p>
      <h1>Bình Minh</h1>
      <p>
        Sản xuất tinh bột sắn với kinh nghiệm tích lũy qua nhiều thập kỷ, không ngừng đổi mới để xây
        dựng quy mô và uy tín bền vững.
      </p>
      <div class="capacity">
        <span class="capacity-icon" aria-hidden="true">⌁</span>
        <span><small>Công suất trung bình</small><strong>200 <em>tấn/ngày</em></strong></span>
      </div>
      <div class="actions">
        <a class="button primary" href="#gioi-thieu">Về chúng tôi <span>→</span></a>
        <a class="button" href="/tuyen-dung/">Tuyển dụng <span>→</span></a>
      </div>
    </div>
    <div
      class="hero-visual"
      role="img"
      aria-label="Vị trí dành cho ảnh toàn cảnh nhà máy Bình Minh"
    >
    </div>
  </section>

  <section class="facts" aria-label="Các mốc chính">
    <div class="fact"><strong>1984</strong><span>Năm thành lập</span></div>
    <div class="fact"><strong>2006</strong><span>Chuyển về địa điểm hiện tại</span></div>
    <div class="fact"><strong>≈ 200 tấn</strong><span>Công suất trung bình mỗi ngày</span></div>
  </section>

  <section id="gioi-thieu" class="section">
    <SectionHeading
      eyebrow="Giới thiệu về Bình Minh"
      title="Kinh nghiệm được bồi đắp qua thời gian"
      intro="Binh Minh Tapioca Starch Production Limited được thành lập từ năm 1984 và chuyển về địa điểm hiện tại vào năm 2006."
    />
    <div class="story-grid">
      <div class="story-card">
        <strong>Hơn bốn thập kỷ</strong>
        <p>
          Qua nhiều năm tích lũy kinh nghiệm và không ngừng đổi mới, Bình Minh đã xây dựng một vị
          trí nhất định trong ngành về quy mô cũng như uy tín bền vững.
        </p>
      </div>
      <div class="story-card">
        <strong>Ổn định để phát triển</strong>
        <p>
          Chúng tôi hướng đến năng lực sản xuất ổn định, quan hệ hợp tác lâu dài và sự cải tiến có
          trách nhiệm trong từng giai đoạn phát triển.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <SectionHeading eyebrow="Cách chúng tôi làm việc" title="Năm nguyên tắc cùng giữ gìn" />
    <div class="principles">
      {
        principles.map(([title, detail]) => (
          <div class="principle">
            <>
              <b>{title}</b>
              <br />
            </>
            {detail}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
