---
const title = 'Bình Minh | Website đang được xây dựng';
const description =
  'Website chính thức của Bình Minh đang được xây dựng trên một nền tảng nhanh, ổn định và bền vững.';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f6f2e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section aria-labelledby="page-title">
        <p class="eyebrow">Bình Minh · Red Tiger Head</p>
        <h1 id="page-title">Một nền tảng bền vững đang được hình thành.</h1>
        <p class="intro">
          Website chính thức của Bình Minh đang trong giai đoạn xây dựng. Chúng tôi ưu tiên sự rõ
          ràng, tốc độ và độ tin cậy ngay từ nền móng.
        </p>
        <div class="status" role="status">
          <span aria-hidden="true"></span>
          Đang chuẩn bị nội dung và nhận diện chính thức
        </div>
      </section>
    </main>
    <footer><p>© {new Date().getFullYear()} Bình Minh</p></footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    color: #24221e;
    background: #f6f2e8;
    font-synthesis: none;
  }
  * {
    box-sizing: border-box;
  }
  body {
    min-height: 100vh;
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    background:
      radial-gradient(circle at 15% 15%, rgb(166 63 43 / 10%), transparent 30rem), #f6f2e8;
  }
  main {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    display: grid;
    align-items: center;
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  section {
    max-width: 52rem;
  }
  .eyebrow {
    margin: 0 0 1.25rem;
    color: #8f3527;
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 15ch;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem, 8vw, 6.4rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .intro {
    max-width: 42rem;
    margin: 2rem 0 0;
    color: #5b574f;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }
  .status {
    width: fit-content;
    margin-top: 2.25rem;
    display: flex;
    gap: 0.7rem;
    align-items: center;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(36 34 30 / 15%);
    border-radius: 999px;
    background: rgb(255 255 255 / 45%);
    color: #4c4942;
    font-size: 0.9rem;
  }
  .status span {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #a63f2b;
    box-shadow: 0 0 0 0.25rem rgb(166 63 43 / 13%);
  }
  footer {
    width: min(100% - 2rem, 72rem);
    margin-inline: auto;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(36 34 30 / 12%);
    color: #716c62;
    font-size: 0.85rem;
  }
  footer p {
    margin: 0;
  }
</style>
