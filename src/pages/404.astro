---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<BaseLayout title="Không tìm thấy trang | Bình Minh" description="Trang bạn tìm kiếm không tồn tại.">
  <SiteHeader active="home" />
  <main id="main" class="not-found wine-zone">
    <div class="shell">
      <p class="eyebrow gold">404</p>
      <h1 data-i18n data-vi="Không tìm thấy trang" data-en="Page not found" data-zh="找不到页面">Không tìm thấy trang</h1>
      <p data-i18n data-vi="Đường dẫn có thể đã thay đổi hoặc không còn tồn tại." data-en="The address may have changed or may no longer exist." data-zh="该地址可能已更改或不再存在。">Đường dẫn có thể đã thay đổi hoặc không còn tồn tại.</p>
      <a class="btn btn-outline-gold" href="/" data-i18n data-vi="Về trang chủ" data-en="Back to home" data-zh="返回首页">Về trang chủ</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
