---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";
import RecruitmentForm from "../../components/RecruitmentForm.astro";
import Icon from "../../components/Icon.astro";
import jobs from "../../data/jobs.json";
import { copy, i18n } from "../../data/site";

const principles = [
  { icon: "target", vi: "Chính trực & Minh bạch", en: "Integrity & Transparency", zh: "诚信与透明", viD: "Trung thực trong công việc và báo cáo.", enD: "Be honest in work and reporting.", zhD: "在工作与汇报中保持诚实。" },
  { icon: "users", vi: "Tôn trọng & Hợp tác", en: "Respect & Cooperation", zh: "尊重与合作", viD: "Tôn trọng đồng nghiệp, quy trình và tài sản chung.", enD: "Respect colleagues, processes and shared assets.", zhD: "尊重同事、流程与公共财产。" },
  { icon: "trend", vi: "Trách nhiệm & Kỷ luật", en: "Responsibility & Discipline", zh: "责任与纪律", viD: "Hoàn thành công việc với trách nhiệm rõ ràng và tác phong kỷ luật.", enD: "Work with clear responsibility and disciplined execution.", zhD: "以明确责任和纪律完成工作。" },
  { icon: "bulb", vi: "Đổi mới & Hiệu quả", en: "Innovation & Efficiency", zh: "创新与效率", viD: "Chủ động cải thiện cách làm để tăng hiệu quả thực tế.", enD: "Improve practical ways of working to raise efficiency.", zhD: "主动改进工作方式，提高实际效率。" },
  { icon: "shield", vi: "An toàn & Bền vững", en: "Safety & Sustainability", zh: "安全与可持续", viD: "Ưu tiên an toàn lao động và tư duy phát triển dài hạn.", enD: "Prioritize occupational safety and long-term development.", zhD: "优先考虑生产安全与长期发展。" }
] as const;

---
<BaseLayout title="Tuyển dụng | Bình Minh" description="Tuyển dụng Bình Minh — xem vị trí đang tuyển và chuẩn bị hồ sơ ứng tuyển.">
  <SiteHeader active="careers" />
  <main id="main">
    <PageHero kicker="careers.kicker" title="careers.title" lead="careers.lead" />
    <section class="content-section porcelain-zone">
      <div class="shell careers-grid">
        <div>
          <article class="panel">
            <h2 class="section-kicker" {...i18n("careers.principles")}>{copy.vi["careers.principles"]}</h2>
            <div class="principle-grid">
              {principles.map((principle) => (
                <div class="principle-item">
                  <span class="principle-icon"><Icon name={principle.icon} size={29} /></span>
                  <b data-i18n data-vi={principle.vi} data-en={principle.en} data-zh={principle.zh}>{principle.vi}</b>
                  <small data-i18n data-vi={principle.viD} data-en={principle.enD} data-zh={principle.zhD}>{principle.viD}</small>
                </div>
              ))}
            </div>
          </article>
          <article class="panel jobs-card">
            <h2 class="section-kicker" {...i18n("careers.openings")}>{copy.vi["careers.openings"]}</h2>
            <div class="jobs-list">
              {jobs.filter((job) => job.status === "open").map((job) => (
                <details class="job-card">
                  <summary>
                    <span class="job-visual" aria-hidden="true">
                      <img src={job.icon} alt="" width="96" height="96" loading="lazy" decoding="async" />
                    </span>
                    <span class="job-title-block">
                      <small data-i18n data-vi={job.department.vi} data-en={job.department.en}>{job.department.vi}</small>
                      <b data-i18n data-vi={job.title.vi} data-en={job.title.en}>{job.title.vi}</b>
                      <span class="job-salary">
                        <span data-i18n data-vi="Mức lương:" data-en="Salary:">Mức lương:</span>
                        <strong data-i18n data-vi={job.salary.vi} data-en={job.salary.en}>{job.salary.vi}</strong>
                      </span>
                      <span class="job-summary" data-i18n data-vi={job.summary.vi} data-en={job.summary.en}>{job.summary.vi}</span>
                    </span>
                    <span class="detail-action" data-i18n data-vi="Chi tiết +" data-en="Details +">Chi tiết +</span>
                  </summary>
                  <div class="job-detail">
                    <h3 data-i18n data-vi="Vai trò" data-en="Role">Vai trò</h3><p data-i18n data-vi={job.role.vi} data-en={job.role.en}>{job.role.vi}</p>
                    <h3 data-i18n data-vi="Yêu cầu" data-en="Requirements">Yêu cầu</h3><p data-i18n data-vi={job.requirements.vi} data-en={job.requirements.en}>{job.requirements.vi}</p>
                    <h3 data-i18n data-vi="Lương & quyền lợi" data-en="Salary & benefits">Lương & quyền lợi</h3><p data-i18n data-vi={job.benefits.vi} data-en={job.benefits.en}>{job.benefits.vi}</p>
                    <a href={job.detailFile} target="_blank" rel="noopener" class="text-link" data-i18n data-vi="Hỏi thêm về vị trí này →" data-en="Learn more about this role →">Hỏi thêm về vị trí này →</a>
                  </div>
                </details>
              ))}
            </div>
          </article>
        </div>
        <RecruitmentForm />
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
